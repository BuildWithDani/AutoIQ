{
  "name": "autoiq",
  "version": "0.1.0",
  "description": "AI-powered OBD2 diagnostics + performance tool",
  "main": "electron/main.js",
  "scripts": {
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --port 8001",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "electron .",
    "dev": "npm run build:frontend && npm run dev:electron",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "build:win": "npm run build:frontend && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "build:mac": "npm run build:frontend && electron-builder --mac",
    "install:all": "npm install && cd frontend && npm install",
    "start": "electron ."
  },
  "keywords": [
    "obd2",
    "diagnostics",
    "automotive"
  ],
  "author": "BuildWithDani (BWD)",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "axios": "^1.6.5"
  }
}

